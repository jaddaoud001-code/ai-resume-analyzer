# Copier en .env (à la racine du repo). Ne renseigner que la clé du fournisseur utilisé.
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Fournisseur d'embeddings : local (défaut, aucun envoi externe) | openai | mistral.
# EMBEDDINGS_PROVIDER=local
# Modèle d'embeddings ; par défaut selon le fournisseur :
#   local   -> intfloat/multilingual-e5-large (téléchargé au premier lancement, ~2,2 Go)
#   openai  -> text-embedding-3-small
#   mistral -> mistral-embed
# EMBEDDINGS_MODEL=
# Dossier de cache des modèles locaux.
# EMBEDDINGS_CACHE_DIR=~/.cache/ai-resume-analyzer/fastembed

# Fournisseur du LLM : mistral (défaut) | openai.
# LLM_PROVIDER=mistral

# --- Configuration testée avec le quota gratuit de Mistral ---
# Les alias (mistral-small-latest…) et les modèles ministral peuvent être refusés ou limités à
# 2 requêtes/min sur l'offre gratuite ; mistral-large-4-0 est accepté (50 requêtes/min,
# 20 000 tokens/min). Le compte est aussi limité à 1 requête/s : LLM_RPS=0.1 (un départ toutes
# les 10 s) reste sous la limite de tokens par minute, et 5 nouvelles tentatives sur 429
# absorbent les dépassements restants. Une analyse dure alors 2 à 5 minutes.
# Quota payant : augmentez LLM_RPS (par exemple 0.5 à 1, sans dépasser les requêtes/s de votre
# offre) et éventuellement LLM_CONCURRENCY ; les en-têtes x-ratelimit-* journalisés sur 429
# indiquent les limites réelles du compte.
# Avec LLM_PROVIDER=openai, commentez LLM_MODEL et MATCH_LLM_MODEL (défaut : gpt-4o-mini).
# Modèle d'extraction des exigences ; sans valeur : mistral-small-latest (mistral) ou gpt-4o-mini (openai).
LLM_MODEL=mistral-large-4-0
# Modèle d'évaluation des exigences (un appel par exigence) ; sans valeur : ministral-14b-2512 (mistral).
MATCH_LLM_MODEL=mistral-large-4-0
# Limiteur partagé par tous les appels au LLM : requêtes/s au départ (défaut 0.5).
LLM_RPS=0.1
# Sur 429 : nouvelles tentatives (défaut 3) ; attente selon Retry-After, sinon 60 / limite s si
# l'en-tête x-ratelimit-limit-req-minute est présent, 60 s si le quota de tokens de la minute est
# épuisé, sinon attente croissante à partir de LLM_RATE_LIMIT_BACKOFF_S (doublée à chaque fois).
LLM_RATE_LIMIT_RETRIES=5
# --- Fin de la configuration testée ---

# Appels au LLM simultanés au plus.
# LLM_CONCURRENCY=4
# LLM_RATE_LIMIT_BACKOFF_S=2.0
# Délai maximal d'une réponse du LLM, en secondes.
# LLM_TIMEOUT_S=60
# Graine (random_seed Mistral, seed OpenAI) ; vide : aucune. Ne rend pas Mistral reproductible.
# LLM_SEED=42

# Matching : chunks par exigence, points par niveau et poids (JSON).
# MATCH_K=5
# Places du top MATCH_K réservées aux sections d'expérience et de projets, et mots-clés
# (sans accents) qui identifient ces sections.
# MATCH_RESERVED_K=3
# MATCH_RESERVED_SECTIONS=["EXPERIENCE", "PROJET", "STAGE"]
# MATCH_LEVEL_POINTS={"non démontré": 0, "mentionné": 40, "démontré": 75, "solide": 100}
# MATCH_WEIGHTS={"obligatoire": 2, "souhaitée": 1, "savoir-être souhaité": 0.5}

# Offre d'emploi : taille maximale (413 au-delà) et nombre maximal d'exigences extraites.
# MAX_JOB_OFFER_CHARS=15000
# MAX_REQUIREMENTS=15
# Cache LRU en mémoire des exigences extraites (nombre d'offres) ; 0 : désactivé.
# REQUIREMENTS_CACHE_SIZE=64

# Découpage du CV et recherche.
# CHUNK_MAX_CHARS=800
# CHUNK_OVERLAP=80
# SEARCH_K=4

# Limites d'extraction des CV (valeurs par défaut).
# MAX_PDF_SIZE_BYTES=5242880
# MAX_PDF_PAGES=10
# MIN_TEXT_CHARS=100

# POST /analyze (SSE) : analyses simultanées (429 au-delà), durée maximale en secondes,
# intervalle des pings SSE en secondes (0 : aucun).
# ANALYSIS_CONCURRENCY=2
# ANALYSIS_TIMEOUT_S=600
# SSE_PING_S=15

# Routes /debug/* (à désactiver en production).
# ENABLE_DEBUG_ROUTES=true

# DEBUG : journalise l'empreinte (sha256) du PDF reçu et du texte extrait par /debug/parse.
# LOG_LEVEL=INFO
