# Copier en .env (à la racine du repo). Ne renseigner que la clé du fournisseur utilisé.
GROQ_API_KEY=
# MISTRAL_API_KEY=
# OPENAI_API_KEY=

# Fournisseur d'embeddings : local (défaut, aucun envoi externe) | openai | mistral.
# EMBEDDINGS_PROVIDER=local
# Modèle d'embeddings ; par défaut selon le fournisseur :
#   local   -> intfloat/multilingual-e5-large (téléchargé au premier lancement, ~2,2 Go)
#   openai  -> text-embedding-3-small
#   mistral -> mistral-embed
# EMBEDDINGS_MODEL=
# Dossier de cache des modèles locaux.
# EMBEDDINGS_CACHE_DIR=~/.cache/ai-resume-analyzer/fastembed

# Fournisseur du LLM : groq (défaut) | mistral | openai.
LLM_PROVIDER=groq

# --- Configuration testée avec l'offre gratuite de Groq (novembre 2026) ---
# Les offres gratuites changent : Mistral a retiré l'accès API de la sienne en novembre 2026
# (403 « not available in your subscription tier » sur tous les modèles), alors que ce projet
# y avait été mis au point. Vérifiez les modèles et limites de votre compte dans la console
# du fournisseur ; les en-têtes x-ratelimit-* journalisés sur 429 les indiquent aussi.
# Limites gratuites constatées sur gpt-oss-120b, par modèle : 30 requêtes/min, 1 000/jour,
# 8 000 tokens/min et 200 000 tokens/jour. Un appel d'évaluation consomme ~2 000 à 2 500
# tokens (le texte du CV fourni domine) : LLM_RPS=0.05 (un départ toutes les 20 s, au plus
# 3 appels/min) reste sous 8 000 tokens/min. Une analyse (1 extraction + ~15 évaluations)
# dure alors 5 à 6 minutes et consomme ~40 000 tokens : 4 à 5 analyses par jour. Au-delà,
# l'analyse s'arrête avec « Quota journalier du fournisseur LLM atteint : réessayez demain ».
# Modèle d'extraction des exigences ; sans valeur : openai/gpt-oss-120b (groq),
# mistral-small-latest (mistral), gpt-4o-mini (openai).
LLM_MODEL=openai/gpt-oss-120b
# Modèle d'évaluation des exigences (un appel par exigence) ; sans valeur : openai/gpt-oss-120b
# (groq), ministral-14b-2512 (mistral), gpt-4o-mini (openai).
MATCH_LLM_MODEL=openai/gpt-oss-120b
# Effort de raisonnement des modèles qui raisonnent (gpt-oss) : low | medium | high ; sans
# valeur : défaut du modèle. À laisser vide pour un modèle qui ne raisonne pas (l'API refuse
# le paramètre). Évaluation en « low » : environ deux fois moins de tokens de sortie (~15 %
# du total) ; l'extraction garde le défaut (en « low », elle omettait des compétences tirées
# des missions).
# LLM_REASONING_EFFORT=
MATCH_LLM_REASONING_EFFORT=low
# Limiteur partagé par tous les appels au LLM : requêtes/s au départ (défaut 0.5).
LLM_RPS=0.05
# Sur 429 : nouvelles tentatives (défaut 3). Attente : Retry-After, ou reprise des tokens de la
# minute (x-ratelimit-reset-tokens chez Groq), pendant laquelle le limiteur se met en pause ;
# sinon 60 / limite s si l'en-tête x-ratelimit-limit-req-minute (Mistral) est présent, sinon
# attente croissante à partir de LLM_RATE_LIMIT_BACKOFF_S. Jamais de nouvelle tentative sur
# un quota journalier épuisé, une clé refusée (401) ou un modèle refusé (403).
LLM_RATE_LIMIT_RETRIES=5
# Une seule analyse à la fois : deux analyses se partageraient le quota par minute et
# dépasseraient ANALYSIS_TIMEOUT_S (600 s).
ANALYSIS_CONCURRENCY=1
# --- Fin de la configuration testée ---

# Basculer sur une offre payante :
#   Mistral : LLM_PROVIDER=mistral, MISTRAL_API_KEY, LLM_MODEL et MATCH_LLM_MODEL autorisés par
#             l'abonnement (mistral-large-4-0 a donné les résultats d'évaluation du README),
#             retirer MATCH_LLM_REASONING_EFFORT ; LLM_RPS=0.5 à 1 selon le débit de l'offre.
#   OpenAI  : LLM_PROVIDER=openai, OPENAI_API_KEY, commenter LLM_MODEL et MATCH_LLM_MODEL
#             (défaut gpt-4o-mini) et MATCH_LLM_REASONING_EFFORT (gpt-4o-mini ne raisonne pas) ;
#             LLM_RPS=1 ou plus selon le palier du compte.
#   Groq payant (Developer) : mêmes réglages, LLM_RPS=0.5 ou plus et ANALYSIS_CONCURRENCY=2.

# Appels au LLM simultanés au plus.
# LLM_CONCURRENCY=4
# LLM_RATE_LIMIT_BACKOFF_S=2.0
# Délai maximal d'une réponse du LLM, en secondes.
# LLM_TIMEOUT_S=60
# Graine (seed Groq et OpenAI, random_seed Mistral) ; vide : aucune. Ne garantit pas des
# résultats reproductibles (constaté chez Mistral).
# LLM_SEED=42

# Matching : chunks par exigence, points par niveau et poids (JSON).
# MATCH_K=5
# Places du top MATCH_K réservées aux sections d'expérience et de projets, et mots-clés
# (sans accents) qui identifient ces sections.
# MATCH_RESERVED_K=3
# MATCH_RESERVED_SECTIONS=["EXPERIENCE", "PROJET", "STAGE"]
# MATCH_LEVEL_POINTS={"non démontré": 0, "mentionné": 40, "démontré": 75, "solide": 100}
# MATCH_WEIGHTS={"obligatoire": 2, "souhaitée": 1, "savoir-être souhaité": 0.5}

# Offre d'emploi : taille maximale (413 au-delà) et nombre maximal d'exigences extraites.
# MAX_JOB_OFFER_CHARS=15000
# MAX_REQUIREMENTS=15
# Cache LRU en mémoire des exigences extraites (nombre d'offres) ; 0 : désactivé.
# REQUIREMENTS_CACHE_SIZE=64

# Découpage du CV et recherche.
# CHUNK_MAX_CHARS=800
# CHUNK_OVERLAP=80
# SEARCH_K=4

# Limites d'extraction des CV (valeurs par défaut).
# MAX_PDF_SIZE_BYTES=5242880
# MAX_PDF_PAGES=10
# MIN_TEXT_CHARS=100

# POST /analyze (SSE) : durée maximale en secondes, intervalle des pings SSE en secondes
# (0 : aucun). Analyses simultanées (429 au-delà) : ANALYSIS_CONCURRENCY, plus haut.
# ANALYSIS_TIMEOUT_S=600
# SSE_PING_S=15

# Routes /debug/* (à désactiver en production).
# ENABLE_DEBUG_ROUTES=true

# DEBUG : journalise l'empreinte (sha256) du PDF reçu et du texte extrait par /debug/parse.
# LOG_LEVEL=INFO
